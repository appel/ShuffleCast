<icecast>
    <location>Earth 1</location>
    <admin>your@email.address</admin>
    <hostname>localhost</hostname>

    <listen-socket>
        <port>8000</port>
        <!-- Uncomment if you want to bind to all addresses -->
        <!-- <bind-address>0.0.0.0</bind-address> -->
    </listen-socket>

    <authentication>
        <source-password>hunter2</source-password>
    </authentication>

    <fileserving>1</fileserving>

    <paths>
        <logdir>/var/log/icecast2</logdir>
    </paths>

    <logging>
        <accesslog>access.log</accesslog>
        <errorlog>error.log</errorlog>
        <loglevel>1</loglevel>
    </logging>

    <security>
        <!-- Disable built-in admin pages -->
        <chroot>0</chroot>
        <changeowner>
            <user>icecast2</user>
            <group>icecast</group>
        </changeowner>
    </security>
</icecast>
